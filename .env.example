# ============================================================
# Telegram OSINT Intelligence Platform - environment template
# Copy to .env and fill in. NEVER commit .env.
# ============================================================

# --- Runtime ---
APP_ENV=development            # development | staging | production
APP_DEBUG=true
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                 # true in production

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of trusted browser origins for the dashboard.
# Never use "*" together with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Security / crypto ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_64_byte_urlsafe_token
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# --- Database ---
# Production: postgresql+psycopg://user:pass@host:5432/telegram_osint
DATABASE_URL=postgresql+psycopg://osint:osint@localhost:5432/telegram_osint

# --- Redis / job queue ---
REDIS_URL=redis://localhost:6379/0

# --- Telegram Bot API (bot-scoped data only) ---
TELEGRAM_BOT_TOKEN=CHANGE_ME
# Whitelisted numeric Telegram user IDs allowed to use the bot (comma-separated).
TELEGRAM_ALLOWED_USER_IDS=
# Numeric Telegram user IDs with admin commands (comma-separated).
TELEGRAM_ADMIN_USER_IDS=

# --- Optional: explicitly authorized operator account (Telethon/Pyrogram) ---
# Leave blank unless the operator has legally configured an authorized account.
TELEGRAM_OPERATOR_API_ID=
TELEGRAM_OPERATOR_API_HASH=
TELEGRAM_OPERATOR_SESSION=

# --- External OSINT source API keys (all optional) ---
GITHUB_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=telegram-osint-research/1.0

# --- Outbound fetcher / SSRF guard ---
HTTP_FETCH_TIMEOUT_SECONDS=10
HTTP_FETCH_MAX_BYTES=5242880
HTTP_FETCH_MAX_REDIRECTS=3
# Allow fetching private/loopback addresses (DANGEROUS - tests only).
HTTP_FETCH_ALLOW_PRIVATE=false

# --- Rate limits (configurable) ---
RATE_LIMIT_SEARCH_PER_MINUTE=10
RATE_LIMIT_REPORTS_PER_HOUR=5
RATE_LIMIT_WATCH_MAX_TARGETS=25
